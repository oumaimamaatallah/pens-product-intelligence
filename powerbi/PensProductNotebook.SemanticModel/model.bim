{
  "name": "PensProductNotebook",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Products",
        "lineageTag": "94999141-93da-5b4f-83b9-4afc25240893",
        "columns": [
          {
            "name": "sku",
            "dataType": "string",
            "sourceColumn": "sku",
            "summarizeBy": "none"
          },
          {
            "name": "product_name",
            "dataType": "string",
            "sourceColumn": "product_name",
            "summarizeBy": "none"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          },
          {
            "name": "material",
            "dataType": "string",
            "sourceColumn": "material",
            "summarizeBy": "none"
          },
          {
            "name": "imprint_process",
            "dataType": "string",
            "sourceColumn": "imprint_process",
            "summarizeBy": "none"
          },
          {
            "name": "product_url",
            "dataType": "string",
            "sourceColumn": "product_url",
            "summarizeBy": "none"
          },
          {
            "name": "observed_at",
            "dataType": "string",
            "sourceColumn": "observed_at",
            "summarizeBy": "none"
          },
          {
            "name": "data_origin",
            "dataType": "string",
            "sourceColumn": "data_origin",
            "summarizeBy": "none"
          },
          {
            "name": "unit_price_low",
            "dataType": "double",
            "sourceColumn": "unit_price_low",
            "summarizeBy": "none"
          },
          {
            "name": "unit_price_high",
            "dataType": "double",
            "sourceColumn": "unit_price_high",
            "summarizeBy": "none"
          },
          {
            "name": "rating",
            "dataType": "double",
            "sourceColumn": "rating",
            "summarizeBy": "none"
          },
          {
            "name": "minimum_order",
            "dataType": "double",
            "sourceColumn": "minimum_order",
            "summarizeBy": "none"
          },
          {
            "name": "review_count",
            "dataType": "double",
            "sourceColumn": "review_count",
            "summarizeBy": "none"
          },
          {
            "name": "ship_days",
            "dataType": "double",
            "sourceColumn": "ship_days",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Products",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Source = Table.FromRows(Rows, {\"sku\", \"product_name\", \"category\", \"material\", \"imprint_process\", \"product_url\", \"observed_at\", \"data_origin\", \"unit_price_low\", \"unit_price_high\", \"rating\", \"minimum_order\", \"review_count\", \"ship_days\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"sku\", type text}, {\"product_name\", type text}, {\"category\", type text}, {\"material\", type text}, {\"imprint_process\", type text}, {\"product_url\", type text}, {\"observed_at\", type text}, {\"data_origin\", type text}, {\"unit_price_low\", type number}, {\"unit_price_high\", type number}, {\"rating\", type number}, {\"minimum_order\", type number}, {\"review_count\", type number}, {\"ship_days\", type number}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Products observed",
            "expression": "DISTINCTCOUNT(Products[sku])",
            "formatString": "#,0"
          },
          {
            "name": "Median starting price",
            "expression": "MEDIAN(Products[unit_price_low])",
            "formatString": "$#,0.00"
          },
          {
            "name": "Average product rating",
            "expression": "AVERAGE(Products[rating])",
            "formatString": "0.0"
          },
          {
            "name": "Median order minimum",
            "expression": "MEDIAN(Products[minimum_order])",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Scenario",
        "lineageTag": "e6cacbde-2695-5a95-9f67-e9e19d25ec1d",
        "columns": [
          {
            "name": "line_id",
            "dataType": "string",
            "sourceColumn": "line_id",
            "summarizeBy": "none"
          },
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "sku",
            "dataType": "string",
            "sourceColumn": "sku",
            "summarizeBy": "none"
          },
          {
            "name": "customer_segment",
            "dataType": "string",
            "sourceColumn": "customer_segment",
            "summarizeBy": "none"
          },
          {
            "name": "channel",
            "dataType": "string",
            "sourceColumn": "channel",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "data_origin",
            "dataType": "string",
            "sourceColumn": "data_origin",
            "summarizeBy": "none"
          },
          {
            "name": "order_date",
            "dataType": "dateTime",
            "sourceColumn": "order_date",
            "summarizeBy": "none"
          },
          {
            "name": "units",
            "dataType": "int64",
            "sourceColumn": "units",
            "summarizeBy": "none"
          },
          {
            "name": "revenue",
            "dataType": "double",
            "sourceColumn": "revenue",
            "summarizeBy": "none"
          },
          {
            "name": "item_cost",
            "dataType": "double",
            "sourceColumn": "item_cost",
            "summarizeBy": "none"
          },
          {
            "name": "gross_profit",
            "dataType": "double",
            "sourceColumn": "gross_profit",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Scenario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Source = Table.FromRows(Rows, {\"line_id\", \"order_id\", \"sku\", \"customer_segment\", \"channel\", \"status\", \"data_origin\", \"order_date\", \"units\", \"revenue\", \"item_cost\", \"gross_profit\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"line_id\", type text}, {\"order_id\", type text}, {\"sku\", type text}, {\"customer_segment\", type text}, {\"channel\", type text}, {\"status\", type text}, {\"data_origin\", type text}, {\"order_date\", type date}, {\"units\", Int64.Type}, {\"revenue\", type number}, {\"item_cost\", type number}, {\"gross_profit\", type number}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Simulated net sales",
            "expression": "SUM(Scenario[revenue])",
            "formatString": "$#,0"
          },
          {
            "name": "Assumed gross profit",
            "expression": "SUM(Scenario[gross_profit])",
            "formatString": "$#,0"
          },
          {
            "name": "Assumed gross margin",
            "expression": "DIVIDE([Assumed gross profit], [Simulated net sales], 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Delivered orders",
            "expression": "CALCULATE(DISTINCTCOUNT(Scenario[order_id]), Scenario[status] = \"delivered\")",
            "formatString": "#,0"
          },
          {
            "name": "Delivered units",
            "expression": "CALCULATE(SUM(Scenario[units]), Scenario[status] = \"delivered\")",
            "formatString": "#,0"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Scenario_Products",
        "fromTable": "Scenario",
        "fromColumn": "sku",
        "toTable": "Products",
        "toColumn": "sku",
        "crossFilteringBehavior": "oneDirection"
      }
    ]
  }
}